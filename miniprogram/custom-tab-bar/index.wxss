.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 247, 250, 0), rgba(245, 247, 250, 0.96) 32%);
}

.tab-bar {
  height: 112rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(228, 231, 236, 0.9);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(16, 24, 40, 0.14);
  display: grid;
  gap: 8rpx;
}

.tab-item {
  height: 92rpx;
  border-radius: 24rpx;
  color: #667085;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-item.active {
  background: #eef4ff;
  color: #0052d9;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.tab-item.active .tab-icon {
  background: #0052d9;
  color: #ffffff;
}

.tab-text {
  font-size: 22rpx;
  font-weight: 600;
}
