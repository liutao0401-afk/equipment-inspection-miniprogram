<view class="page messages-page">
  <t-loading wx:if="{{loading}}" theme="spinner" text="加载中..." />

  <block wx:else>
    <view class="header">
      <text class="page-title">消息中心</text>
      <text class="mark-all-btn" bindtap="markAllRead">全部已读</text>
    </view>

    <view wx:if="{{messages.length === 0}}" class="empty-state">
      <t-icon name="notification" size="80rpx" />
      <text class="empty-text">暂无消息</text>
    </view>

    <view wx:else class="msg-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="msg-card {{item.isRead ? '' : 'msg-unread'}}"
        bindtap="goDetail"
        data-id="{{item.id}}"
      >
        <view class="msg-dot {{item.isRead ? 'dot-read' : 'dot-unread'}}"></view>
        <view class="msg-content">
          <view class="msg-header">
            <text class="msg-title">{{item.title}}</text>
            <text class="msg-time">{{item._time}}</text>
          </view>
          <text class="msg-desc">{{item.content}}</text>
        </view>
      </view>
    </view>
  </block>
</view>