.messages-page {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eef0f4;
}

.page-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #101828;
}

.mark-all-btn {
  font-size: 26rpx;
  color: #0052d9;
  font-weight: 500;
}

.mark-all-btn:active {
  opacity: 0.7;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
  color: #98a2b3;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #98a2b3;
}

.msg-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #eef0f4;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.msg-card:active {
  opacity: 0.85;
}

.msg-unread {
  background: #f8faff;
  border-color: #d6e4ff;
}

.msg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.dot-unread {
  background: #0052d9;
}

.dot-read {
  background: #d0d5dd;
}

.msg-content {
  flex: 1;
  min-width: 0;
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.msg-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #101828;
}

.msg-time {
  font-size: 20rpx;
  color: #98a2b3;
  flex-shrink: 0;
}

.msg-desc {
  display: block;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}