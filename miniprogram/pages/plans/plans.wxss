.plans-page {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eef0f4;
}

.page-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #101828;
}

.add-btn {
  flex-shrink: 0;
}

.plan-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #eef0f4;
}

.plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.plan-route {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-route-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #101828;
}

.plan-title-group {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.plan-code {
  font-size: 22rpx;
  color: #98a2b3;
}

.plan-status {
  flex-shrink: 0;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-on {
  background: #e8f8ee;
  color: #0b8a3a;
}

.status-off {
  background: #f2f4f7;
  color: #98a2b3;
}

.plan-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.plan-label {
  font-size: 22rpx;
  color: #98a2b3;
}

.plan-value {
  font-size: 26rpx;
  color: #344054;
  font-weight: 500;
}

.plan-cycle {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #eef4ff;
  color: #0052d9;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  align-self: flex-start;
}

.plan-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef0f4;
}

.plan-viewonly {
  padding-top: 20rpx;
  border-top: 1rpx solid #eef0f4;
  text-align: center;
}

.viewonly-text {
  font-size: 24rpx;
  color: #98a2b3;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.edit-btn {
  background: #f0f4ff;
  color: #0052d9;
}

.delete-btn {
  background: #fef3f2;
  color: #c01048;
}

/* ===== 表单弹窗 ===== */
.form-panel {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom, 20rpx));
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #101828;
}

.form-body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #344054;
}

.form-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  border: 1rpx solid #e4e7ec;
  font-size: 28rpx;
  color: #101828;
}

.placeholder {
  color: #98a2b3;
}

.cycle-group {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.cycle-option {
  padding: 20rpx 8rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx solid #e4e7ec;
  font-size: 26rpx;
  font-weight: 500;
  color: #667085;
  transition: all 0.2s;
}

.cycle-option:active {
  opacity: 0.7;
}

.cycle-active {
  border-color: #0052d9;
  background: #eef4ff;
  color: #0052d9;
  font-weight: 700;
}

.form-footer {
  margin-top: 40rpx;
}