<view class="page profile-page">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-info">
      <text class="name">{{user.name || user.username || '未登录'}}</text>
      <text class="role">{{roleText}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">基本信息</text>
    </view>
    <view class="info-row">
      <text class="info-label">账号</text>
      <text class="info-value">{{user.username || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">姓名</text>
      <text class="info-value">{{user.name || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">角色</text>
      <text class="info-value info-role">{{roleText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">班组</text>
      <text class="info-value">{{user.teamName || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">电话</text>
      <text class="info-value">{{user.phone || '-'}}</text>
    </view>
  </view>

  <!-- 安全设置 -->
  <view class="section-card">
    <view class="section-header" bindtap="togglePasswordSection">
      <view class="section-header-left">
        <text class="section-title">安全设置</text>
      </view>
      <view class="section-arrow {{showPasswordSection ? 'arrow-up' : ''}}">›</view>
    </view>

    <view wx:if="{{showPasswordSection}}" class="password-section">
      <view class="field">
        <text class="field-label">当前密码</text>
        <view class="field-input-wrapper">
          <input
            class="field-input"
            type="{{showOldPwd ? 'text' : 'password'}}"
            placeholder="请输入当前密码"
            value="{{oldPassword}}"
            bindinput="onOldPasswordInput"
          />
          <view class="pwd-toggle" bindtap="toggleShowOldPwd">
            <text class="pwd-toggle-icon">{{showOldPwd ? '👁' : '👁‍🗨'}}</text>
          </view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">新密码</text>
        <view class="field-input-wrapper">
          <input
            class="field-input"
            type="{{showNewPwd ? 'text' : 'password'}}"
            placeholder="请输入新密码（至少6位）"
            value="{{newPassword}}"
            bindinput="onNewPasswordInput"
          />
          <view class="pwd-toggle" bindtap="toggleShowNewPwd">
            <text class="pwd-toggle-icon">{{showNewPwd ? '👁' : '👁‍🗨'}}</text>
          </view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">确认新密码</text>
        <view class="field-input-wrapper">
          <input
            class="field-input"
            type="{{showConfirmPwd ? 'text' : 'password'}}"
            placeholder="请再次输入新密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
          <view class="pwd-toggle" bindtap="toggleShowConfirmPwd">
            <text class="pwd-toggle-icon">{{showConfirmPwd ? '👁' : '👁‍🗨'}}</text>
          </view>
        </view>
      </view>

      <view class="password-hint">
        <text class="hint-icon">⚠️</text>
        <text class="hint-text">密码修改成功后，下次登录需要使用新密码</text>
      </view>

      <t-button block theme="primary" loading="{{changingPassword}}" bind:tap="changePassword">
        修改密码
      </t-button>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view wx:if="{{user.role === 'admin' || (user.role === 'inspector' && user.isLeader)}}" class="section-card menu-section">
    <view class="menu-item" bindtap="goPlans">
      <text class="menu-icon">📋</text>
      <text class="menu-text">巡检计划管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <t-button block theme="danger" variant="outline" bind:tap="logout">退出登录</t-button>
  </view>
</view>