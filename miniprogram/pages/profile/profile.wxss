.profile-page {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* ===== 用户信息卡片 ===== */
.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #0052d9, #0a7bff);
  color: #ffffff;
  margin-bottom: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.profile-info {
  flex: 1;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.role {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ===== 分区卡片 ===== */
.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f1f4;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}

.section-arrow {
  font-size: 36rpx;
  color: #98a2b3;
  transition: transform 0.2s;
}

.arrow-up {
  transform: rotate(90deg);
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #98a2b3;
}

.info-value {
  font-size: 28rpx;
  color: #101828;
  font-weight: 500;
}

.info-role {
  padding: 4rpx 16rpx;
  background: #e8f4fd;
  color: #0052d9;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* ===== 密码修改表单 ===== */
.password-section {
  padding-top: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #5f6b7a;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field-input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.field-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #101828;
  background: transparent;
}

.pwd-toggle {
  padding: 12rpx;
  font-size: 32rpx;
  line-height: 1;
}

.password-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 20rpx;
  background: #fff8e6;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.hint-icon {
  font-size: 24rpx;
  line-height: 1.4;
}

.hint-text {
  font-size: 24rpx;
  color: #b8860b;
  line-height: 1.4;
}

/* ===== 菜单 ===== */
.menu-section {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #101828;
  font-weight: 500;
}

.menu-arrow {
  font-size: 40rpx;
  color: #98a2b3;
}

/* ===== 退出登录 ===== */
.logout-section {
  margin-top: 48rpx;
  padding-bottom: 40rpx;
}