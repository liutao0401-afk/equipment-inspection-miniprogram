/* pages/index/index.wxss */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
  background-color: #F8FAFC;
}

/* web-view 全屏 */
web-view {
  width: 100%;
  height: 100vh;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #64748B;
}

/* 错误遮罩 */
.error-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.error-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 60rpx;
}

.error-icon {
  font-size: 80rpx;
}

.error-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1E293B;
}

.error-msg {
  font-size: 26rpx;
  color: #64748B;
  text-align: center;
}

.retry-btn {
  margin-top: 20rpx;
  background-color: #3B82F6;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border: none;
}

.retry-btn:active {
  background-color: #2563EB;
}
