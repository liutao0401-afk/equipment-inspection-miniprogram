.detail-page {
  min-height: 100vh;
  background: #f5f7fa;
}

.detail-wrapper {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.msg-header-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid #eef0f4;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.msg-type-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.icon-info { background: #eef4ff; color: #0052d9; }
.icon-warning { background: #fff7e6; color: #e67e00; }
.icon-error { background: #fef3f2; color: #c01048; }
.icon-success { background: #ecfdf3; color: #12b76a; }

.msg-header-info {
  flex: 1;
  min-width: 0;
}

.msg-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #101828;
}

.msg-time {
  display: block;
  font-size: 22rpx;
  color: #98a2b3;
  margin-top: 6rpx;
}

.content-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  border: 1rpx solid #eef0f4;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.content-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #344054;
  margin-bottom: 16rpx;
}

.content-body {
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #101828;
  line-height: 1.6;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e4e7ec;
}

.image-item:active {
  opacity: 0.85;
}

.image-thumb {
  width: 100%;
  height: 100%;
}